        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotify へのアクセスが拒否されました。システム設定 ＞ プライバシーとセキュリティ ＞ オートメーションで LyricShiori を許可し、アプリを再起動してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
